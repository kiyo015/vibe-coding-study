{
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(node checks/health-check.js*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)"
    ]
  },
  "extraKnownMarketplaces": {
    "vibe-study-local": {
      "source": {
        "source": "directory",
        "path": "./plugins"
      }
    }
  },
  "enabledPlugins": {
    "dev-guard@vibe-study-local": true
  }
}
